---
import { getEmDashEntry } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ProductPurchase from "../../components/ProductPurchase";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
	getBasePrice,
	getBaseStock,
	getBaseWeightGrams,
	getCuratedProductGallery,
	getPriceRange,
	getProductVariants,
	getTrackStock,
} from "../../utils/products";
import { buildProduct, stripToPlainText } from "../../utils/structured-data";
import { resolveMediaUrl } from "../../utils/post-format";
import {
	EMBEDDED_NFC_ONLY,
	INITIALS_OR_ICON_ONLY,
	LOGO_SURCHARGE,
	LOGO_SURCHARGE_BY_VARIANT,
} from "../../utils/surcharges";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

if (slug === "knuckles" || slug === "cheatstick" || slug === "chetastick") {
	return Astro.redirect("/products/amoeba", 301);
}

const { entry: product, cacheHint } = await getEmDashEntry("products", slug).catch(() => ({ entry: null, cacheHint: null }));

if (!product) {
	return Astro.redirect("/404");
}

if (cacheHint) {
	Astro.cache.set(cacheHint);
}

const productKey = product.slug || product.id;
const galleryUnique = getCuratedProductGallery(productKey, product.data);
const displayImageUrl = galleryUnique[0]?.src || resolveMediaUrl(product.data.featured_image);

const variants = getProductVariants(product.data);
const priceRange = getPriceRange(product.data);
const basePrice = getBasePrice(product.data);
const baseStock = getBaseStock(product.data);
const baseWeightGrams = getBaseWeightGrams(product.data);

// Products that do NOT offer text/NFC personalization or a body colour
// (e.g. chalk packs, which only have a quantity/pack option).
const NO_PERSONALIZATION = new Set(["chalkable", "knuckles", "amoeba"]);
const NO_COLOR = new Set<string>(["safe9"]);
const COLOUR_REQUEST = new Set(["chalkable"]);
const LOGO_UPLOAD = new Set(["chalkable"]);

// Products that display variants as radio buttons instead of a dropdown
const RADIO_VARIANTS = new Set(["safe9", "chalkable"]);
// Products that require an explicit variant pick before adding to cart.
const REQUIRE_VARIANT = new Set(["safe9"]);
// Products that track stock per-variant and show remaining counts.
const TRACK_STOCK = new Set(["safe9"]);
// EMBEDDED_NFC_ONLY, INITIALS_OR_ICON_ONLY, LOGO_SURCHARGE and
// LOGO_SURCHARGE_BY_VARIANT now live in utils/surcharges.ts so the cart price and
// the Stripe checkout amount share one source of truth.
const requireVariant = REQUIRE_VARIANT.has(productKey);

// First colour variant drives the default gallery image for colour products.
// For require-variant products the gallery starts on slide 0 (featured image).
const defaultVariantColor = requireVariant ? "" : (variants[0]?.optionValue || "").toLowerCase();
const allowsPersonalization = !NO_PERSONALIZATION.has(productKey);
const hasTextOption = allowsPersonalization;
const hasNfcOption = allowsPersonalization || EMBEDDED_NFC_ONLY.has(productKey);
const showColor = !NO_COLOR.has(productKey);
const allowColourRequest = COLOUR_REQUEST.has(productKey);
const allowLogoUpload = LOGO_UPLOAD.has(productKey);
const embeddedNfcOnly = EMBEDDED_NFC_ONLY.has(productKey);
const useRadioVariants = RADIO_VARIANTS.has(productKey);
const logoSurcharge = LOGO_SURCHARGE[productKey] || 0;
const logoSurchargeByVariant = LOGO_SURCHARGE_BY_VARIANT[productKey];
const initialsOrIconOnly = INITIALS_OR_ICON_ONLY.has(productKey);
const allowFaceUpload = productKey === "racksafe9";
const trackStock = getTrackStock(product.data) || TRACK_STOCK.has(productKey);

// Per-product "Nogenn colour" add-on (the rubber grip), mirrored from the
// legacy WordPress product options. Keyed by slug until colours move into the CMS.
const NOGENN_COLOURS_BY_SLUG: Record<string, string[]> = {
	amoeba: ["white", "black", "yellow", "blue"],
	knuckles: ["white", "black", "yellow", "blue"],
	cheatstick: ["white", "black", "yellow", "blue"],
};
const nogennColours = NOGENN_COLOURS_BY_SLUG[product.slug || product.id] ?? [];

const priceLabel =
	priceRange.min === priceRange.max
		? `$${priceRange.min.toFixed(2)}`
		: `$${priceRange.min.toFixed(2)} - $${priceRange.max.toFixed(2)}`;

const metaDescription = stripToPlainText(product.data.excerpt ?? product.data.description) || undefined;
const productJsonLd = buildProduct(product, Astro.url.origin);
---

<Base
	title={`${product.data.title} | Cueism`}
	description={metaDescription}
	image={displayImageUrl}
	ogType="product"
	jsonLd={productJsonLd}
>
	<Breadcrumbs
		items={[
			{ label: "Home", href: "/" },
			{ label: "Shop", href: "/products" },
			{ label: product.data.title },
		]}
	/>

	<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-xl); margin-top: var(--spacing-md);">
		<div>
			{galleryUnique.length > 0 ? (
				<div class="product-gallery" data-default-color={defaultVariantColor}>
					<div class="product-gallery-main" role="button" tabindex="0" aria-label="Click to zoom product image">
						{galleryUnique.map((image, i) => {
							const src = image.src || "";
							const isColorsImage = src.includes("racksafe9_colors.jpg");
							return (
								<div
									class={`product-gallery-slide${isColorsImage ? " colors-group-image" : ""}`}
									data-gallery-index={i}
									data-color={image.color}
									data-personalization={image.personalization}
									data-src={image.src}
									data-alt={image.alt}
									style={`background: var(--color-bg-surface); border-radius: var(--radius-md); overflow: hidden;${i === 0 ? "" : " display: none;"}`}
								>
									<Image image={image} />
								</div>
							);
						})}
						<span class="product-gallery-zoom-hint" aria-hidden="true">Click to zoom</span>
					</div>
					{galleryUnique.length > 1 && (
						<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 0.5rem; margin-top: 0.75rem;">
							{galleryUnique.map((image, i) => (
								<button
									type="button"
									class="product-gallery-thumb"
									data-gallery-index={i}
									data-color={image.color}
									data-personalization={image.personalization}
									aria-label={image.alt || `View image ${i + 1}`}
									title={image.alt || `Image ${i + 1}`}
									style="border: 1px solid var(--color-border-light); border-radius: var(--radius-sm); overflow: hidden; padding: 0; background: none; cursor: pointer; line-height: 0;"
								>
									<Image image={image} />
								</button>
							))}
						</div>
					)}
					<dialog class="product-lightbox" aria-label={`${product.data.title} enlarged image`}>
						<div class="product-lightbox-inner">
							<button type="button" class="product-lightbox-close" aria-label="Close zoom view">✕</button>
							{galleryUnique.length > 1 && (
								<button type="button" class="product-lightbox-nav product-lightbox-prev" aria-label="Previous image">‹</button>
							)}
							<figure class="product-lightbox-figure">
								<img class="product-lightbox-img" src={galleryUnique[0]?.src} alt={galleryUnique[0]?.alt || product.data.title} />
								<figcaption class="product-lightbox-caption">{galleryUnique[0]?.alt || product.data.title}</figcaption>
							</figure>
							{galleryUnique.length > 1 && (
								<button type="button" class="product-lightbox-nav product-lightbox-next" aria-label="Next image">›</button>
							)}
						</div>
					</dialog>
				</div>
			) : (
				<div style="background: var(--color-bg-surface); border-radius: var(--radius-md); aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center;">
					<p style="color: var(--color-text-tertiary);">No image</p>
				</div>
			)}
		</div>

		<div>
			<h1 style="font-size: 2rem; font-weight: 400; margin-bottom: var(--spacing-sm);">
				{product.data.title}
			</h1>
			
			<div style="font-size: 1.5rem; font-weight: 500; color: var(--color-text-primary); margin-bottom: var(--spacing-md);">
				{priceLabel}
			</div>

			<ProductPurchase
				client:load
				productId={product.id}
				slug={product.slug || product.id}
				title={product.data.title}
				image={displayImageUrl}
				basePrice={basePrice}
				baseStock={baseStock}
				baseWeightGrams={baseWeightGrams}
				trackStock={trackStock}
				variants={variants}
				hasTextOption={hasTextOption}
				hasNfcOption={hasNfcOption}
				nogennColours={nogennColours}
				showColor={showColor}
				allowColourRequest={allowColourRequest}
				allowLogoUpload={allowLogoUpload}
				embeddedNfcOnly={embeddedNfcOnly}
				useRadioVariants={useRadioVariants}
				logoSurcharge={logoSurcharge}
				logoSurchargeByVariant={logoSurchargeByVariant}
				initialsOrIconOnly={initialsOrIconOnly}
				allowFaceUpload={allowFaceUpload}
				requireVariant={requireVariant}
			/>
		</div>
	</div>

	{product.data.content && (
		<div style="margin-top: var(--spacing-lg); padding-top: var(--spacing-lg); border-top: 1px solid var(--color-border-light); max-width: 840px;">
			<h2 style="font-size: 1rem; font-weight: 500; margin-bottom: var(--spacing-sm);">Description</h2>
			<div style="color: var(--color-text-secondary); line-height: 1.7;">
				<PortableText value={product.data.content} />
			</div>
		</div>
	)}

	<style>
		@media (max-width: 768px) {
			div[style*="grid-template-columns: 1fr 1fr"] {
				grid-template-columns: 1fr !important;
			}
		}
		.product-gallery-main {
			position: relative;
			width: 100%;
			aspect-ratio: 1/1; /* Square */
			border-radius: var(--radius-md);
			overflow: hidden;
			background: var(--color-bg-surface);
			cursor: zoom-in;
		}
		.product-gallery-zoom-hint {
			position: absolute;
			right: 0.75rem;
			bottom: 0.75rem;
			padding: 0.25rem 0.6rem;
			border-radius: 999px;
			background: rgba(15, 23, 42, 0.68);
			color: #fff;
			font-size: 0.75rem;
			letter-spacing: 0.01em;
			pointer-events: none;
			opacity: 0;
			transition: opacity 0.18s ease;
		}
		.product-gallery-main:hover .product-gallery-zoom-hint,
		.product-gallery-main:focus-visible .product-gallery-zoom-hint {
			opacity: 1;
		}
		.product-gallery-slide {
			width: 100%;
			height: 100%;
		}
		.product-gallery-slide img,
		.product-gallery-slide :global(img) {
			width: 100% !important;
			height: 100% !important;
			object-fit: cover !important;
		}
		.product-gallery-thumb {
			width: 100%;
			aspect-ratio: 1/1; /* Square to match 1:1 product photos */
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--color-bg-surface);
			overflow: hidden;
			transition: outline-color 0.15s ease, transform 0.15s ease;
			outline: 2px solid transparent;
			outline-offset: -2px;
		}
		.product-gallery-thumb img,
		.product-gallery-thumb :global(img) {
			width: 100% !important;
			height: 100% !important;
			object-fit: cover !important;
		}
		.product-gallery-thumb[aria-current="true"] {
			outline-color: var(--color-accent);
		}
		.product-gallery-thumb:hover {
			outline-color: var(--color-border);
		}
		.product-lightbox {
			border: none;
			border-radius: var(--radius-md);
			padding: 0;
			max-width: min(92vw, 860px);
			max-height: 92vh;
			background: transparent;
			color: #fff;
		}
		.product-lightbox::backdrop {
			background: rgba(10, 15, 25, 0.85);
			backdrop-filter: blur(4px);
		}
		.product-lightbox-inner {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.product-lightbox-figure {
			margin: 0;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.625rem;
		}
		.product-lightbox-img {
			max-width: min(88vw, 780px);
			max-height: 80vh;
			width: auto;
			height: auto;
			border-radius: var(--radius-md);
			box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
			object-fit: contain;
			background: var(--color-bg-surface);
		}
		.product-lightbox-caption {
			font-size: 0.875rem;
			color: rgba(255, 255, 255, 0.9);
			text-align: center;
			max-width: 65ch;
		}
		.product-lightbox-close {
			position: absolute;
			top: 0.625rem;
			right: 0.625rem;
			width: 2.25rem;
			height: 2.25rem;
			border-radius: 999px;
			border: none;
			background: rgba(15, 23, 42, 0.75);
			color: #fff;
			font-size: 1rem;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			z-index: 2;
		}
		.product-lightbox-nav {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			width: 2.5rem;
			height: 2.5rem;
			border-radius: 999px;
			border: none;
			background: rgba(15, 23, 42, 0.75);
			color: #fff;
			font-size: 1.5rem;
			line-height: 1;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			z-index: 2;
		}
		.product-lightbox-prev {
			left: 0.625rem;
		}
		.product-lightbox-next {
			right: 0.625rem;
		}
	</style>

	<script>
		function initProductGalleries(): void {
			document.querySelectorAll<HTMLElement>(".product-gallery").forEach((gallery) => {
				if (gallery.dataset.galleryReady === "1") return; // avoid double-binding
				gallery.dataset.galleryReady = "1";

				const slides = Array.from(gallery.querySelectorAll<HTMLElement>(".product-gallery-slide"));
				const thumbs = Array.from(gallery.querySelectorAll<HTMLElement>(".product-gallery-thumb"));
				const mainBox = gallery.querySelector<HTMLElement>(".product-gallery-main");
				const lightbox = gallery.querySelector<HTMLDialogElement>(".product-lightbox");
				const lightboxImg = lightbox?.querySelector<HTMLImageElement>(".product-lightbox-img");
				const lightboxCaption = lightbox?.querySelector<HTMLElement>(".product-lightbox-caption");
				const closeBtn = lightbox?.querySelector<HTMLButtonElement>(".product-lightbox-close");
				const prevBtn = lightbox?.querySelector<HTMLButtonElement>(".product-lightbox-prev");
				const nextBtn = lightbox?.querySelector<HTMLButtonElement>(".product-lightbox-next");
				if (!slides.length) return;

				let currentIndex = 0;

				const syncLightbox = (idx: number) => {
					const activeSlide = slides[idx];
					if (!activeSlide || !lightboxImg) return;
					const src = activeSlide.dataset.src || activeSlide.querySelector("img")?.getAttribute("src") || "";
					const alt = activeSlide.dataset.alt || activeSlide.querySelector("img")?.getAttribute("alt") || "";
					if (src) lightboxImg.src = src;
					lightboxImg.alt = alt;
					if (lightboxCaption) lightboxCaption.textContent = alt;
				};

				const show = (indexStr: string) => {
					const parsed = Number.parseInt(indexStr, 10);
					currentIndex = Number.isFinite(parsed) && parsed >= 0 && parsed < slides.length ? parsed : 0;
					const target = String(currentIndex);
					slides.forEach((s) => {
						s.style.display = s.dataset.galleryIndex === target ? "" : "none";
					});
					thumbs.forEach((t) => {
						t.setAttribute("aria-current", t.dataset.galleryIndex === target ? "true" : "false");
					});
					syncLightbox(currentIndex);
				};

				const step = (delta: number) => {
					const next = (currentIndex + delta + slides.length) % slides.length;
					show(String(next));
				};

				// Find the slide tagged with a given colour (a slide may serve several
				// colours via a comma-separated data-color, e.g. "black,white").
				const findColorIndex = (color: string | undefined): string | null => {
					if (!color) return null;
					const normalized = color.toLowerCase();
					const exactMatch = slides.find((s) => (s.dataset.color || "").toLowerCase() === normalized);
					if (exactMatch) return exactMatch.dataset.galleryIndex || "0";
					const multiMatch = slides.find((s) =>
						(s.dataset.color || "")
							.toLowerCase()
							.split(",")
							.map((c) => c.trim())
							.includes(normalized)
					);
					return multiMatch ? multiMatch.dataset.galleryIndex || "0" : null;
				};

				const findPersonalizationIndex = (personalization: string | undefined): string | null => {
					if (!personalization || personalization === "none") return null;
					const normalized = personalization.toLowerCase();
					const match = slides.find((s) =>
						(s.dataset.personalization || "")
							.toLowerCase()
							.split(",")
							.map((p) => p.trim())
							.includes(normalized)
					);
					return match ? match.dataset.galleryIndex || "0" : null;
				};

				// Let the product form (React island) drive the gallery by colour or personalization.
				(gallery as any)._showColor = (color: string) => {
					const index = findColorIndex(color);
					if (index !== null) show(index);
				};
				(gallery as any)._showPersonalization = (personalization: string) => {
					const index = findPersonalizationIndex(personalization);
					if (index !== null) show(index);
				};

				thumbs.forEach((thumb) => {
					thumb.addEventListener("click", () => show(thumb.dataset.galleryIndex || "0"));
				});

				if (mainBox && lightbox) {
					const openLightbox = () => {
						syncLightbox(currentIndex);
						if (typeof lightbox.showModal === "function") {
							lightbox.showModal();
						}
					};
					mainBox.addEventListener("click", openLightbox);
					mainBox.addEventListener("keydown", (e) => {
						if (e.key === "Enter" || e.key === " ") {
							e.preventDefault();
							openLightbox();
						}
					});
					closeBtn?.addEventListener("click", () => lightbox.close());
					prevBtn?.addEventListener("click", (e) => {
						e.stopPropagation();
						step(-1);
					});
					nextBtn?.addEventListener("click", (e) => {
						e.stopPropagation();
						step(1);
					});
					lightbox.addEventListener("click", (e) => {
						if (e.target === lightbox) lightbox.close();
					});
					lightbox.addEventListener("keydown", (e) => {
						if (e.key === "ArrowLeft") {
							e.preventDefault();
							step(-1);
						} else if (e.key === "ArrowRight") {
							e.preventDefault();
							step(1);
						}
					});
				}

				// Default to the first colour variant's image when one matches.
				const defaultIndex = findColorIndex(gallery.dataset.defaultColor);
				show(defaultIndex !== null ? defaultIndex : "0");
			});
		}

		function showGalleryColor(color: string): void {
			document.querySelectorAll<HTMLElement>(".product-gallery").forEach((gallery) => {
				if (typeof (gallery as any)._showColor === "function") (gallery as any)._showColor(color);
			});
		}

		function showGalleryPersonalization(personalization: string): void {
			document.querySelectorAll<HTMLElement>(".product-gallery").forEach((gallery) => {
				if (typeof (gallery as any)._showPersonalization === "function") {
					(gallery as any)._showPersonalization(personalization);
				}
			});
		}

		// Run now (covers direct loads) and after each view-transition navigation.
		initProductGalleries();
		document.addEventListener("astro:page-load", initProductGalleries);
		window.addEventListener("cueism:variant-color", (e: Event) => {
			const customEvent = e as CustomEvent<{ color: string }>;
			showGalleryColor(customEvent.detail && customEvent.detail.color);
		});
		window.addEventListener("cueism:variant-personalization", (e: Event) => {
			const customEvent = e as CustomEvent<{ personalization: string }>;
			showGalleryPersonalization(customEvent.detail && customEvent.detail.personalization);
		});
	</script>
</Base>
