---
import { QUIZ_QUESTIONS, FARGO_TIERS } from "../../data/poolQuizData";

// Serialize question bank safely for client-side script
const quizDataJson = JSON.stringify(QUIZ_QUESTIONS);
const fargoTiersJson = JSON.stringify(FARGO_TIERS);
---

<div class="quiz-wrapper" id="pool-quiz-root">
	<!-- Collapsed Bar (Shown when minimized) -->
	<button
		type="button"
		class="quiz-collapsed-bar"
		id="quiz-collapsed-bar"
		aria-label="Expand Pool IQ Quiz"
		hidden
	>
		<div class="collapsed-left">
			<span class="quiz-pill-badge">🎱 Pool IQ Challenge</span>
			<span class="collapsed-title" id="collapsed-title-text">Test your table knowledge & FargoRate</span>
		</div>
		<div class="collapsed-right">
			<span class="collapsed-streak" id="collapsed-streak-pill" hidden>🔥 0</span>
			<span class="collapsed-fargo" id="collapsed-fargo-pill">Fargo: ~380</span>
			<span class="collapsed-icon" aria-hidden="true">▼</span>
		</div>
	</button>

	<!-- Main Quiz Card -->
	<section class="quiz-card" id="quiz-card" aria-label="Interactive Pool Knowledge Quiz">
		<!-- Card Top Header -->
		<header class="quiz-header">
			<div class="quiz-meta-left">
				<span class="quiz-tag">🎱 POOL IQ &amp; FARGO TEST</span>
				<span class="quiz-tier-badge" id="quiz-tier-badge">Level 1 • Fargo &lt; 425</span>
				<span class="quiz-streak-badge" id="quiz-streak-badge" hidden>🔥 Streak: 0</span>
			</div>
			<div class="quiz-meta-right">
				<!-- 50/50 Lifeline Button -->
				<button
					type="button"
					class="quiz-lifeline-btn"
					id="quiz-lifeline-btn"
					title="Eliminate 2 wrong answers"
				>
					💡 50/50 (<span id="lifelines-remaining">2</span>)
				</button>
				<span class="quiz-progress-text" id="quiz-progress-text">Shot 1 of 10</span>
				<button
					type="button"
					class="quiz-minimize-btn"
					id="quiz-minimize-btn"
					title="Minimize quiz"
					aria-label="Minimize quiz"
				>
					▲
				</button>
			</div>
		</header>

		<!-- Progress Bar & Live Fargo Meter -->
		<div class="quiz-progress-section">
			<div class="quiz-progress-track">
				<div class="quiz-progress-fill" id="quiz-progress-fill" style="width: 10%;"></div>
			</div>
			<div class="quiz-live-meter">
				<span class="meter-label">Live Rating:</span>
				<span class="meter-fargo" id="meter-fargo">380</span>
				<span class="meter-rank" id="meter-rank">Casual Player</span>
			</div>
		</div>

		<!-- Question View State -->
		<div class="quiz-body" id="quiz-question-view">
			<p class="quiz-scenario" id="quiz-scenario" hidden></p>
			<h2 class="quiz-question-title" id="quiz-question-text">Loading shot scenario...</h2>

			<!-- Multiple Choice Options -->
			<div class="quiz-options-grid" id="quiz-options-container" role="radiogroup">
				<!-- Injected by client script -->
			</div>

			<!-- Feedback & Explanations Panel (Hidden until answered) -->
			<div class="quiz-feedback-panel" id="quiz-feedback-panel" hidden>
				<div class="quiz-feedback-header">
					<div class="feedback-title-group">
						<span class="feedback-status-badge" id="feedback-status-badge">Correct!</span>
						<span class="feedback-punchline" id="feedback-punchline">Pure stroke!</span>
					</div>
					<span class="feedback-fargo-impact" id="feedback-fargo-impact">+35 Fargo</span>
				</div>
				<p class="quiz-explanation-text" id="quiz-explanation-text"></p>

				<!-- Action Buttons -->
				<div class="quiz-action-bar">
					<button type="button" class="btn-quiz-short" id="btn-watch-short">
						<span class="play-icon" aria-hidden="true">▶</span>
						<span id="btn-watch-short-text">Watch Related Short</span>
					</button>
					<button type="button" class="btn-quiz-next" id="btn-next-question">
						<span>Next Shot</span>
						<span aria-hidden="true">→</span>
					</button>
				</div>

				<!-- Inline Popover Video Player (Toggleable) -->
				<div class="quiz-inline-player" id="quiz-inline-player" hidden>
					<div class="inline-player-container" id="inline-player-container">
						<!-- YouTube iframe injected on demand -->
					</div>
					<div class="inline-player-footer">
						<button type="button" class="btn-jump-feed" id="btn-jump-feed">
							View this short in feed below ↓
						</button>
						<button type="button" class="btn-close-player" id="btn-close-player">
							Close Video
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Results / Level-Up Screen State (Shown after a rack or round) -->
		<div class="quiz-results-view" id="quiz-results-view" hidden>
			<div class="results-badge-wrap">
				<div class="results-fargo-circle">
					<span class="fargo-label">EST. FARGO</span>
					<span class="fargo-score" id="results-fargo-score">515</span>
				</div>
				<div class="results-tier-summary">
					<div class="results-round-stats">
						<span class="stat-pill" id="stat-accuracy">8/10 Correct</span>
						<span class="stat-pill streak-pill" id="stat-best-streak">Best Streak: 🔥 4</span>
					</div>
					<h3 class="results-rank-title" id="results-rank-title">Intermediate Shotmaker</h3>
					<p class="results-rank-tagline" id="results-rank-tagline">Table angles & rolling cue ball control</p>
				</div>
			</div>

			<!-- Immediate Continue Bar -->
			<div class="continue-rack-bar">
				<div class="continue-rack-info">
					<span class="continue-headline">Ready for the next rack?</span>
					<span class="continue-sub">Keep your streak going with fresh shots from your NotebookLM bank.</span>
				</div>
				<button type="button" class="btn-keep-rolling" id="btn-keep-rolling">
					🔥 Keep Rolling! Rack Next 5 →
				</button>
			</div>

			<div class="level-up-container">
				<h4 class="level-up-heading">🎯 What You Need to Level Up:</h4>
				<ul class="level-up-list" id="level-up-list">
					<!-- Injected by client script -->
				</ul>
			</div>

			<div class="results-recommended-shorts" id="results-recommended-shorts">
				<h4 class="recommended-heading">📺 Recommended Shorts to Boost Your Game:</h4>
				<div class="recommended-cards-grid" id="recommended-cards-grid">
					<!-- Injected recommendations -->
				</div>
			</div>

			<div class="results-footer">
				<button type="button" class="btn-quiz-retry" id="btn-quiz-retry">
					🔄 Start Fresh Rack
				</button>
			</div>
		</div>
	</section>
</div>

<!-- Hidden payload storage for client script -->
<script is:inline id="pool-quiz-data" type="application/json" set:html={quizDataJson}></script>
<script is:inline id="fargo-tiers-data" type="application/json" set:html={fargoTiersJson}></script>

<style>
	.quiz-wrapper {
		width: 100%;
		max-width: 840px;
		margin: 0 auto var(--spacing-md);
		padding: 0 var(--spacing-sm);
	}

	/* Collapsed Bar */
	.quiz-collapsed-bar {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 1rem;
		background: #111418;
		border: 1px solid #2d333b;
		border-radius: var(--radius-md);
		color: #e6edf3;
		cursor: pointer;
		font-family: var(--font-primary);
		font-size: 0.88rem;
		transition: var(--transition-fast);
		text-align: left;
		box-shadow: var(--shadow-sm);
	}

	.quiz-collapsed-bar:hover {
		background: #161b22;
		border-color: #388bfd;
	}

	.collapsed-left {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.quiz-pill-badge {
		background: #238636;
		color: #fff;
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-full);
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.collapsed-title {
		font-weight: 500;
		color: #c9d1d9;
	}

	.collapsed-right {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.collapsed-streak {
		background: rgba(240, 136, 62, 0.15);
		border: 1px solid rgba(240, 136, 62, 0.35);
		color: #f0883e;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.15rem 0.45rem;
		border-radius: var(--radius-full);
	}

	.collapsed-fargo {
		background: #1f242c;
		border: 1px solid #30363d;
		color: #58a6ff;
		font-weight: 600;
		font-size: 0.78rem;
		padding: 0.2rem 0.55rem;
		border-radius: var(--radius-full);
	}

	.collapsed-icon {
		color: #8b949e;
		font-size: 0.8rem;
	}

	/* Main Quiz Card */
	.quiz-card {
		background: linear-gradient(180deg, #161b22 0%, #0d1117 100%);
		border: 1px solid #30363d;
		border-radius: var(--radius-lg);
		padding: 1.15rem 1.35rem;
		color: #e6edf3;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
		position: relative;
		overflow: hidden;
	}

	/* Top Meta Header */
	.quiz-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.55rem;
		font-size: 0.78rem;
	}

	.quiz-meta-left {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.quiz-tag {
		color: #7ee787;
		font-weight: 700;
		letter-spacing: 0.05em;
		font-size: 0.72rem;
	}

	.quiz-tier-badge {
		background: rgba(56, 139, 253, 0.15);
		color: #58a6ff;
		border: 1px solid rgba(56, 139, 253, 0.35);
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-full);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.quiz-streak-badge {
		background: rgba(240, 136, 62, 0.2);
		color: #f0883e;
		border: 1px solid rgba(240, 136, 62, 0.4);
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-full);
		font-size: 0.72rem;
		font-weight: 700;
		animation: pulseStreak 0.4s ease-out;
	}

	@keyframes pulseStreak {
		0% { transform: scale(0.9); }
		50% { transform: scale(1.1); }
		100% { transform: scale(1); }
	}

	.quiz-meta-right {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	/* 50/50 Lifeline Button */
	.quiz-lifeline-btn {
		background: #21262d;
		border: 1px solid #d29922;
		color: #e3b341;
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.2rem 0.55rem;
		border-radius: var(--radius-full);
		cursor: pointer;
		transition: var(--transition-fast);
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.quiz-lifeline-btn:hover:not(:disabled) {
		background: #d29922;
		color: #000;
	}

	.quiz-lifeline-btn:disabled {
		opacity: 0.35;
		border-color: #30363d;
		color: #8b949e;
		cursor: default;
	}

	.quiz-progress-text {
		color: #8b949e;
		font-size: 0.76rem;
		font-weight: 600;
	}

	.quiz-minimize-btn {
		background: transparent;
		border: 1px solid #30363d;
		color: #8b949e;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.65rem;
		transition: var(--transition-fast);
	}

	.quiz-minimize-btn:hover {
		color: #fff;
		border-color: #8b949e;
		background: #21262d;
	}

	/* Progress Section with Live Meter */
	.quiz-progress-section {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
	}

	.quiz-progress-track {
		flex: 1;
		height: 4px;
		background: #21262d;
		border-radius: var(--radius-full);
		overflow: hidden;
	}

	.quiz-progress-fill {
		height: 100%;
		background: linear-gradient(90deg, #238636 0%, #388bfd 50%, #f0883e 100%);
		border-radius: var(--radius-full);
		transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.quiz-live-meter {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.74rem;
		white-space: nowrap;
	}

	.meter-label {
		color: #8b949e;
	}

	.meter-fargo {
		color: #58a6ff;
		font-weight: 700;
		font-size: 0.82rem;
		transition: transform 0.2s ease;
	}

	.meter-rank {
		color: #8b949e;
		font-size: 0.7rem;
	}

	/* Question Body */
	.quiz-scenario {
		color: #8b949e;
		font-size: 0.8rem;
		margin-bottom: 0.3rem;
		font-style: italic;
	}

	.quiz-question-title {
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
		color: #ffffff;
		margin: 0 0 0.85rem;
	}

	/* Options Grid */
	.quiz-options-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}

	:global(.quiz-option-btn) {
		background: #21262d;
		border: 1px solid #30363d;
		border-radius: var(--radius-md);
		padding: 0.65rem 0.85rem;
		color: #c9d1d9;
		text-align: left;
		font-family: var(--font-primary);
		font-size: 0.84rem;
		line-height: 1.35;
		cursor: pointer;
		transition: var(--transition-fast);
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
	}

	:global(.quiz-option-btn:hover:not(:disabled)) {
		background: #2c333d;
		border-color: #58a6ff;
		color: #ffffff;
		transform: translateY(-1px);
	}

	:global(.quiz-option-btn:disabled) {
		cursor: default;
	}

	:global(.quiz-option-letter) {
		font-weight: 700;
		color: #8b949e;
		min-width: 1.2rem;
	}

	:global(.quiz-option-text) {
		flex: 1;
	}

	/* Option States */
	:global(.quiz-option-btn.state-correct) {
		background: rgba(35, 134, 54, 0.25) !important;
		border-color: #3fb950 !important;
		color: #7ee787 !important;
	}

	:global(.quiz-option-btn.state-incorrect) {
		background: rgba(248, 81, 73, 0.2) !important;
		border-color: #f85149 !important;
		color: #ff7b72 !important;
	}

	:global(.quiz-option-btn.state-eliminated) {
		opacity: 0.25;
		text-decoration: line-through;
		pointer-events: none;
	}

	:global(.quiz-option-btn.state-dimmed) {
		opacity: 0.45;
	}

	/* Feedback Panel */
	.quiz-feedback-panel {
		background: #111418;
		border: 1px solid #30363d;
		border-radius: var(--radius-md);
		padding: 0.85rem 1rem;
		margin-top: 0.6rem;
		animation: fadeIn 0.2s ease-out;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.quiz-feedback-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.4rem;
	}

	.feedback-title-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.feedback-status-badge {
		font-size: 0.82rem;
		font-weight: 700;
	}

	.feedback-status-badge.correct {
		color: #3fb950;
	}

	.feedback-status-badge.incorrect {
		color: #f85149;
	}

	.feedback-punchline {
		font-size: 0.78rem;
		color: #8b949e;
		font-style: italic;
	}

	.feedback-fargo-impact {
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.15rem 0.45rem;
		border-radius: var(--radius-full);
	}

	.feedback-fargo-impact.positive {
		background: rgba(35, 134, 54, 0.2);
		color: #3fb950;
		border: 1px solid rgba(63, 185, 80, 0.3);
	}

	.feedback-fargo-impact.neutral {
		background: rgba(139, 148, 158, 0.15);
		color: #8b949e;
		border: 1px solid rgba(139, 148, 158, 0.3);
	}

	.quiz-explanation-text {
		font-size: 0.85rem;
		color: #c9d1d9;
		line-height: 1.45;
		margin-bottom: 0.75rem;
	}

	.quiz-action-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.btn-quiz-short {
		background: #21262d;
		border: 1px solid #30363d;
		color: #e6edf3;
		padding: 0.45rem 0.85rem;
		border-radius: var(--radius-md);
		font-size: 0.8rem;
		font-weight: 500;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		cursor: pointer;
		transition: var(--transition-fast);
	}

	.btn-quiz-short:hover {
		background: #30363d;
		border-color: #58a6ff;
		color: #58a6ff;
	}

	.play-icon {
		color: #f85149;
		font-size: 0.85rem;
	}

	.btn-quiz-next {
		background: #238636;
		border: 1px solid #2ea043;
		color: #ffffff;
		padding: 0.5rem 1.1rem;
		border-radius: var(--radius-md);
		font-size: 0.84rem;
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		cursor: pointer;
		transition: var(--transition-fast);
	}

	.btn-quiz-next:hover {
		background: #2ea043;
		box-shadow: 0 0 12px rgba(46, 160, 67, 0.4);
	}

	/* Inline Player */
	.quiz-inline-player {
		margin-top: 0.85rem;
		background: #000;
		border: 1px solid #30363d;
		border-radius: var(--radius-md);
		overflow: hidden;
		animation: fadeIn 0.25s ease-out;
	}

	.inline-player-container {
		width: 100%;
		max-width: 320px;
		aspect-ratio: 9 / 16;
		margin: 0 auto;
		background: #000;
		position: relative;
	}

	.inline-player-container iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	.inline-player-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.75rem;
		background: #161b22;
		border-top: 1px solid #30363d;
	}

	.btn-jump-feed {
		background: transparent;
		border: none;
		color: #58a6ff;
		font-size: 0.78rem;
		cursor: pointer;
		text-decoration: underline;
	}

	.btn-close-player {
		background: #21262d;
		border: 1px solid #30363d;
		color: #8b949e;
		padding: 0.25rem 0.55rem;
		border-radius: var(--radius-sm);
		font-size: 0.75rem;
		cursor: pointer;
	}

	.btn-close-player:hover {
		color: #fff;
		border-color: #8b949e;
	}

	/* Results Screen */
	.quiz-results-view {
		animation: fadeIn 0.3s ease-out;
	}

	.results-badge-wrap {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		background: #111418;
		border: 1px solid #30363d;
		border-radius: var(--radius-md);
		padding: 1rem 1.25rem;
		margin-bottom: 0.85rem;
	}

	.results-fargo-circle {
		width: 82px;
		height: 82px;
		border-radius: 50%;
		background: radial-gradient(circle, #1f242c 0%, #0d1117 100%);
		border: 2px solid #388bfd;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 18px rgba(56, 139, 253, 0.3);
		flex-shrink: 0;
	}

	.fargo-label {
		font-size: 0.6rem;
		font-weight: 700;
		color: #8b949e;
		letter-spacing: 0.05em;
	}

	.fargo-score {
		font-size: 1.5rem;
		font-weight: 800;
		color: #58a6ff;
		line-height: 1;
	}

	.results-tier-summary {
		flex: 1;
	}

	.results-round-stats {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.3rem;
	}

	.stat-pill {
		font-size: 0.72rem;
		font-weight: 600;
		background: #21262d;
		border: 1px solid #30363d;
		color: #c9d1d9;
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-full);
	}

	.stat-pill.streak-pill {
		background: rgba(240, 136, 62, 0.15);
