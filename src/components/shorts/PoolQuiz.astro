</style>

<script>
	import type { QuizQuestion, FargoTierInfo } from "../../data/poolQuizData";

	function initPoolQuiz(): void {
		const root = document.getElementById("pool-quiz-root");
		if (!root) return;

		// Load data safely from embedded json
		const dataEl = document.getElementById("pool-quiz-data");
		const tiersEl = document.getElementById("fargo-tiers-data");
		if (!dataEl || !tiersEl) return;

		let allQuestions: QuizQuestion[] = [];
		let fargoTiers: Record<number, FargoTierInfo> = {};
		try {
			allQuestions = JSON.parse(dataEl.textContent || "[]");
			fargoTiers = JSON.parse(tiersEl.textContent || "{}");
		} catch (e) {
			console.error("Failed to parse quiz data", e);
			return;
		}

		// Elements
		const cardEl = document.getElementById("quiz-card");
		const collapsedBar = document.getElementById("quiz-collapsed-bar");
		const minimizeBtn = document.getElementById("quiz-minimize-btn");
		const collapsedFargoPill = document.getElementById("collapsed-fargo-pill");
		const collapsedStreakPill = document.getElementById("collapsed-streak-pill");

		const tierBadge = document.getElementById("quiz-tier-badge");
		const streakBadge = document.getElementById("quiz-streak-badge");
		const lifelineBtn = document.getElementById("quiz-lifeline-btn") as HTMLButtonElement | null;
		const lifelinesRemaining = document.getElementById("lifelines-remaining");
		const progressText = document.getElementById("quiz-progress-text");
		const progressFill = document.getElementById("quiz-progress-fill");

		const meterFargo = document.getElementById("meter-fargo");
		const meterRank = document.getElementById("meter-rank");

		const questionView = document.getElementById("quiz-question-view");
		const questionText = document.getElementById("quiz-question-text");
		const scenarioText = document.getElementById("quiz-scenario");
		const optionsContainer = document.getElementById("quiz-options-container");

		const feedbackPanel = document.getElementById("quiz-feedback-panel");
		const feedbackBadge = document.getElementById("feedback-status-badge");
		const feedbackPunchline = document.getElementById("feedback-punchline");
		const feedbackFargo = document.getElementById("feedback-fargo-impact");
		const feedbackExplanation = document.getElementById("quiz-explanation-text");
		const btnWatchShort = document.getElementById("btn-watch-short");
		const btnWatchShortText = document.getElementById("btn-watch-short-text");
		const btnNext = document.getElementById("btn-next-question");

		const inlinePlayer = document.getElementById("quiz-inline-player");
		const inlinePlayerContainer = document.getElementById("inline-player-container");
		const btnJumpFeed = document.getElementById("btn-jump-feed");
		const btnClosePlayer = document.getElementById("btn-close-player");

		const resultsView = document.getElementById("quiz-results-view");
		const resultsFargoScore = document.getElementById("results-fargo-score");
		const resultsRankTitle = document.getElementById("results-rank-title");
		const resultsRankTagline = document.getElementById("results-rank-tagline");
		const statAccuracy = document.getElementById("stat-accuracy");
		const statBestStreak = document.getElementById("stat-best-streak");
		const btnKeepRolling = document.getElementById("btn-keep-rolling");
		const levelUpList = document.getElementById("level-up-list");
		const recommendedGrid = document.getElementById("recommended-cards-grid");
		const btnRetry = document.getElementById("btn-quiz-retry");

		// State variables
		const RACK_SIZE = 5; // Questions per mini rack
		let activeQuestionPool: QuizQuestion[] = [];
		let usedQuestionIds = new Set<string>();
		let currentQuestionIndex = 0;
		let totalQuestionsAnswered = 0;
		let currentFargo = 380;
		let totalCorrect = 0;
		let currentStreak = 0;
		let bestStreak = 0;
		let lifelinesCount = 2;
		let missedQuestions: QuizQuestion[] = [];
		let answeredCurrent = false;
		let currentShuffledOptions: { text: string; isCorrect: boolean }[] = [];

		const punchlinesCorrect = [
			"Dead center!",
			"Pure stroke!",
			"Ice cold!",
			"Like a seasoned pro!",
			"Table tactician!",
			"Rack 'em up!"
		];

		const punchlinesIncorrect = [
			"Scratched on that one!",
			"Tough rail roll!",
			"Good learning moment!",
			"Table took that one!"
		];

		// LocalStorage key
		const STORAGE_KEY = "cueism_pool_quiz_state_v2";

		function shuffleArray<T>(arr: T[]): T[] {
			const copy = [...arr];
			for (let i = copy.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[copy[i], copy[j]] = [copy[j], copy[i]];
			}
			return copy;
		}

		// Pick questions prioritizing unused ones and progressive tiers
		function prepareNextRack(count: number): void {
			let available = allQuestions.filter((q) => !usedQuestionIds.has(q.id));
			if (available.length < count) {
				// Reset pool if all used
				usedQuestionIds.clear();
				available = [...allQuestions];
			}

			// Group by tier for progressive climb
			const newRack: QuizQuestion[] = [];
			for (let tier = 1; tier <= 5; tier++) {
				const tierAvailable = available.filter((q) => q.tier === tier && !usedQuestionIds.has(q.id));
				if (tierAvailable.length > 0) {
					const picked = tierAvailable[Math.floor(Math.random() * tierAvailable.length)];
					newRack.push(picked);
					usedQuestionIds.add(picked.id);
				}
				if (newRack.length >= count) break;
			}

			// Fallback if needed
			while (newRack.length < count) {
				const leftovers = available.filter((q) => !newRack.includes(q));
				if (leftovers.length === 0) break;
				const picked = leftovers[Math.floor(Math.random() * leftovers.length)];
				newRack.push(picked);
				usedQuestionIds.add(picked.id);
			}

			activeQuestionPool = shuffleArray(newRack);
			currentQuestionIndex = 0;
		}

		function startNewGame(): void {
			usedQuestionIds.clear();
			totalQuestionsAnswered = 0;
			totalCorrect = 0;
			currentStreak = 0;
			bestStreak = 0;
			currentFargo = 380;
			lifelinesCount = 2;
			missedQuestions = [];

			prepareNextRack(RACK_SIZE);
			showQuestionView();
			renderCurrentQuestion();
		}

		function continueNextRack(): void {
			prepareNextRack(RACK_SIZE);
			showQuestionView();
			renderCurrentQuestion();
		}

		function showQuestionView(): void {
			if (questionView) questionView.hidden = false;
			if (resultsView) resultsView.hidden = true;
			if (inlinePlayer) inlinePlayer.hidden = true;
			if (inlinePlayerContainer) inlinePlayerContainer.innerHTML = "";
		}

		function getTierInfo(fargo: number): FargoTierInfo {
			if (fargo >= 650) return fargoTiers[5] || fargoTiers[1];
			if (fargo >= 575) return fargoTiers[4] || fargoTiers[1];
			if (fargo >= 500) return fargoTiers[3] || fargoTiers[1];
			if (fargo >= 425) return fargoTiers[2] || fargoTiers[1];
			return fargoTiers[1];
		}

		function updateLiveMeter(): void {
			const roundedFargo = Math.round(currentFargo);
			const tierInfo = getTierInfo(roundedFargo);

			if (meterFargo) {
				meterFargo.textContent = `${roundedFargo}`;
				meterFargo.style.transform = "scale(1.2)";
				setTimeout(() => {
					if (meterFargo) meterFargo.style.transform = "scale(1)";
				}, 200);
			}
			if (meterRank) meterRank.textContent = tierInfo.title.split("(")[0].trim();
			if (collapsedFargoPill) collapsedFargoPill.textContent = `Fargo: ~${roundedFargo}`;

			// Lifeline status
			if (lifelinesRemaining) lifelinesRemaining.textContent = `${lifelinesCount}`;
			if (lifelineBtn) lifelineBtn.disabled = lifelinesCount <= 0 || answeredCurrent;

			// Streak badge
			if (currentStreak >= 2) {
				if (streakBadge) {
					streakBadge.textContent = `🔥 Streak: ${currentStreak}`;
					streakBadge.hidden = false;
				}
				if (collapsedStreakPill) {
					collapsedStreakPill.textContent = `🔥 ${currentStreak}`;
					collapsedStreakPill.hidden = false;
				}
			} else {
				if (streakBadge) streakBadge.hidden = true;
				if (collapsedStreakPill) collapsedStreakPill.hidden = true;
			}
		}

		function renderCurrentQuestion(): void {
			const q = activeQuestionPool[currentQuestionIndex];
			if (!q) {
				showResults();
				return;
			}

			answeredCurrent = false;
			if (feedbackPanel) feedbackPanel.hidden = true;
			if (inlinePlayer) inlinePlayer.hidden = true;
			if (inlinePlayerContainer) inlinePlayerContainer.innerHTML = "";

			updateLiveMeter();

			// Progress bar inside current rack
			const progressPercent = ((currentQuestionIndex + 1) / RACK_SIZE) * 100;
			if (progressFill) progressFill.style.width = `${progressPercent}%`;
			if (progressText) {
				progressText.textContent = `Shot ${totalQuestionsAnswered + 1} • Level ${q.tier}`;
			}
			if (tierBadge) tierBadge.textContent = q.tierTitle;

			// Question & Scenario
			if (questionText) questionText.textContent = q.question;
			if (scenarioText) {
				if (q.scenario) {
					scenarioText.textContent = `Scenario: ${q.scenario}`;
					scenarioText.hidden = false;
				} else {
					scenarioText.hidden = true;
				}
			}

			// Shuffle options dynamically so the correct answer is never always B
			currentShuffledOptions = shuffleArray(
				q.options.map((optText, idx) => ({
					text: optText,
					isCorrect: idx === q.correctIndex,
				}))
			);

			// Render Options
			if (optionsContainer) {
				optionsContainer.innerHTML = "";
				const letters = ["A", "B", "C", "D"];
				currentShuffledOptions.forEach((item, idx) => {
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "quiz-option-btn";
					btn.setAttribute("role", "radio");
					btn.setAttribute("data-index", `${idx}`);
					btn.setAttribute("aria-checked", "false");
					btn.innerHTML = `
						<span class="quiz-option-letter">${letters[idx]}.</span>
						<span class="quiz-option-text">${item.text}</span>
					`;
					btn.addEventListener("click", () => handleAnswer(idx));
					optionsContainer.appendChild(btn);
				});
			}
		}

		function use5050Lifeline(): void {
			if (lifelinesCount <= 0 || answeredCurrent) return;
			const q = activeQuestionPool[currentQuestionIndex];
			if (!q) return;

			lifelinesCount--;
			if (lifelinesRemaining) lifelinesRemaining.textContent = `${lifelinesCount}`;
			if (lifelineBtn) lifelineBtn.disabled = true;

			// Pick 2 incorrect options from the currently rendered shuffled options
			const incorrectIndices = currentShuffledOptions
				.map((item, idx) => ({ idx, isCorrect: item.isCorrect }))
				.filter((o) => !o.isCorrect)
				.map((o) => o.idx);

			const toEliminate = shuffleArray(incorrectIndices).slice(0, 2);

			const optionBtns = optionsContainer?.querySelectorAll<HTMLButtonElement>(".quiz-option-btn");
			optionBtns?.forEach((btn, idx) => {
				if (toEliminate.includes(idx)) {
					btn.classList.add("state-eliminated");
					btn.disabled = true;
				}
			});
		}

		lifelineBtn?.addEventListener("click", use5050Lifeline);

		function handleAnswer(selectedIndex: number): void {
			if (answeredCurrent) return;
			answeredCurrent = true;

			const q = activeQuestionPool[currentQuestionIndex];
			if (!q) return;

			totalQuestionsAnswered++;
			const chosen = currentShuffledOptions[selectedIndex];
			const isCorrect = chosen ? chosen.isCorrect : false;
			const optionBtns = optionsContainer?.querySelectorAll<HTMLButtonElement>(".quiz-option-btn");

			// Disable buttons and set status classes
			optionBtns?.forEach((btn, idx) => {
				btn.disabled = true;
				const isThisCorrect = currentShuffledOptions[idx]?.isCorrect;
				if (isThisCorrect) {
					btn.classList.add("state-correct");
				} else if (idx === selectedIndex && !isCorrect) {
					btn.classList.add("state-incorrect");
				} else {
					btn.classList.add("state-dimmed");
				}
			});

			// Calculate Fargo impact & Streak
			let fargoDelta = 0;
			if (isCorrect) {
				totalCorrect++;
				currentStreak++;
				if (currentStreak > bestStreak) bestStreak = currentStreak;

				// Base tier points + streak multiplier bonus
				const streakBonus = Math.min(25, (currentStreak - 1) * 5);
				fargoDelta = 30 + q.tier * 12 + streakBonus;
				currentFargo = Math.min(750, currentFargo + fargoDelta);
			} else {
				missedQuestions.push(q);
				currentStreak = 0;
				// Slight penalty to simulate realistic rating swings
				currentFargo = Math.max(300, currentFargo - 8);
			}

			updateLiveMeter();

			// Show feedback
			if (feedbackPanel && feedbackBadge && feedbackFargo && feedbackExplanation) {
				feedbackBadge.textContent = isCorrect ? "✓ Spot On!" : "✗ Missed It";
				feedbackBadge.className = `feedback-status-badge ${isCorrect ? "correct" : "incorrect"}`;

				if (feedbackPunchline) {
					const list = isCorrect ? punchlinesCorrect : punchlinesIncorrect;
					feedbackPunchline.textContent = list[Math.floor(Math.random() * list.length)];
				}

				feedbackFargo.textContent = isCorrect
					? `+${fargoDelta} Fargo ${currentStreak > 1 ? `(🔥 Streak x${currentStreak})` : ""}`
					: "-8 Fargo";
				feedbackFargo.className = `feedback-fargo-impact ${isCorrect ? "positive" : "neutral"}`;

				feedbackExplanation.textContent = q.explanation;
				feedbackPanel.hidden = false;
			}

			// Configure Short Button
			if (btnWatchShortText) {
				btnWatchShortText.textContent = `Watch: "${q.videoTitle}"`;
			}
			if (btnWatchShort) {
				btnWatchShort.onclick = () => toggleInlineShort(q.videoId);
			}

			// Configure Next button
			if (btnNext) {
				const isEndOfRack = currentQuestionIndex >= RACK_SIZE - 1;
				btnNext.innerHTML = isEndOfRack
					? `<span>View Rack Score</span> <span aria-hidden="true">→</span>`
					: `<span>Next Shot</span> <span aria-hidden="true">→</span>`;
				btnNext.onclick = () => {
					if (isEndOfRack) {
						showResults();
					} else {
						currentQuestionIndex++;
						renderCurrentQuestion();
					}
				};
			}
		}

		function toggleInlineShort(videoId: string): void {
			if (!inlinePlayer || !inlinePlayerContainer) return;

			if (!inlinePlayer.hidden && inlinePlayerContainer.querySelector("iframe")) {
				inlinePlayer.hidden = true;
				inlinePlayerContainer.innerHTML = "";
				return;
			}

			inlinePlayerContainer.innerHTML = `
				<iframe
					src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&playsinline=1"
					title="Cueism Pool Short"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				></iframe>
			`;
			inlinePlayer.hidden = false;

			// Setup jump to feed button
			if (btnJumpFeed) {
				btnJumpFeed.onclick = () => {
					inlinePlayer.hidden = true;
					inlinePlayerContainer.innerHTML = "";
					jumpToShortInFeed(videoId);
				};
			}

			if (btnClosePlayer) {
				btnClosePlayer.onclick = () => {
					inlinePlayer.hidden = true;
					inlinePlayerContainer.innerHTML = "";
				};
			}
		}

		function jumpToShortInFeed(videoId: string): void {
			const targetThumb = document.querySelector<HTMLElement>(`.short-thumb[data-video-id="${videoId}"]`);
			if (!targetThumb) {
				window.open(`https://www.youtube.com/shorts/${videoId}`, "_blank");
				return;
			}

			const card = targetThumb.closest<HTMLElement>(".short-card");
			if (card) {
				card.scrollIntoView({ behavior: "smooth", block: "center" });
				card.style.outline = "3px solid #f2a900";
				card.style.transition = "outline 0.3s ease";
				setTimeout(() => {
					card.style.outline = "none";
				}, 2500);

				// Trigger play if desktop click listener
				targetThumb.click();
			}
		}

		function showResults(): void {
			if (questionView) questionView.hidden = true;
			if (resultsView) resultsView.hidden = false;
			if (feedbackPanel) feedbackPanel.hidden = true;
			if (inlinePlayer) inlinePlayer.hidden = true;
			if (inlinePlayerContainer) inlinePlayerContainer.innerHTML = "";

			const finalFargo = Math.round(currentFargo);
			const tierInfo = getTierInfo(finalFargo);

			if (resultsFargoScore) resultsFargoScore.textContent = `${finalFargo}`;
			if (resultsRankTitle) resultsRankTitle.textContent = tierInfo.title;
			if (resultsRankTagline) resultsRankTagline.textContent = tierInfo.tagline;
			if (collapsedFargoPill) collapsedFargoPill.textContent = `Fargo: ~${finalFargo}`;

			if (statAccuracy) {
				statAccuracy.textContent = `${totalCorrect}/${totalQuestionsAnswered} Shots Pocketed (${Math.round((totalCorrect / Math.max(1, totalQuestionsAnswered)) * 100)}%)`;
			}
			if (statBestStreak) {
				statBestStreak.textContent = `Best Streak: 🔥 ${bestStreak}`;
			}

			// Level-Up Diagnostics
			if (levelUpList) {
				levelUpList.innerHTML = "";
				const adviceItems: string[] = [];

				if (missedQuestions.length > 0) {
					// Take unique advice items
					const uniqueAdvice = Array.from(new Set(missedQuestions.map((q) => q.levelUpAdvice)));
					uniqueAdvice.slice(0, 4).forEach((adv) => adviceItems.push(adv));
				} else {
					adviceItems.push(
						"🔥 Unstoppable run! To maintain high Fargo, practice your 2-rail diamond kick systems and pressure-test straight-in shots with the MoFUDAT drill."
					);
				}

				// Always add a tier-specific growth tip
				if (tierInfo.tier < 5) {
					const nextTier = fargoTiers[tierInfo.tier + 1];
					if (nextTier) {
						adviceItems.push(`Target for Fargo ${nextTier.minFargo}+: ${nextTier.overview}`);
					}
				}

				adviceItems.forEach((tip) => {
					const li = document.createElement("li");
					li.className = "level-up-item";
					li.textContent = tip;
					levelUpList.appendChild(li);
				});
			}

			// Recommended Shorts
			if (recommendedGrid) {
				recommendedGrid.innerHTML = "";
				const shortsToRec: { videoId: string; title: string }[] = [];
				if (missedQuestions.length > 0) {
					missedQuestions.forEach((q) => {
						if (!shortsToRec.some((s) => s.videoId === q.videoId)) {
							shortsToRec.push({ videoId: q.videoId, title: q.videoTitle });
						}
					});
				} else {
					activeQuestionPool.forEach((q) => {
						if (!shortsToRec.some((s) => s.videoId === q.videoId)) {
							shortsToRec.push({ videoId: q.videoId, title: q.videoTitle });
						}
					});
				}

				shortsToRec.slice(0, 4).forEach((s) => {
					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "rec-short-btn";
					btn.innerHTML = `
						<span class="play-icon" aria-hidden="true">▶</span>
						<span>${s.title}</span>
					`;
					btn.addEventListener("click", () => jumpToShortInFeed(s.videoId));
					recommendedGrid.appendChild(btn);
				});
			}

			// Save best Fargo & streak to storage
			try {
				const existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
				const newBest = Math.max(existing.bestFargo || 0, finalFargo);
				const newBestStreak = Math.max(existing.bestStreak || 0, bestStreak);
				localStorage.setItem(
					STORAGE_KEY,
					JSON.stringify({
						bestFargo: newBest,
						bestStreak: newBestStreak,
						timestamp: Date.now(),
					})
				);
			} catch (_) {}
		}

		// Collapsing logic
		function toggleCollapse(collapsed: boolean): void {
			if (!cardEl || !collapsedBar) return;
			if (collapsed) {
				cardEl.hidden = true;
				collapsedBar.hidden = false;
			} else {
				cardEl.hidden = false;
				collapsedBar.hidden = true;
			}
		}

		minimizeBtn?.addEventListener("click", () => toggleCollapse(true));
		collapsedBar?.addEventListener("click", () => toggleCollapse(false));
		btnKeepRolling?.addEventListener("click", () => continueNextRack());
		btnRetry?.addEventListener("click", () => startNewGame());

		// Restore best Fargo if available
		try {
			const saved = localStorage.getItem(STORAGE_KEY);
			if (saved) {
				const parsed = JSON.parse(saved);
				if (parsed?.bestFargo && collapsedFargoPill) {
					collapsedFargoPill.textContent = `Best: ~${parsed.bestFargo}`;
				}
			}
		} catch (_) {}

		// Start initial rack
		startNewGame();
	}

	// Support Astro view transitions and standard load
	document.addEventListener("astro:page-load", initPoolQuiz);
</script>
